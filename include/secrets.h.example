#pragma once

// Copy this file to secrets.h and fill in your values.
// secrets.h is gitignored and must never be committed.

#define WIFI_SSID     "YourNetworkSSID"
#define WIFI_PASSWORD "YourNetworkPassword"

// Center coordinate for aircraft query
#define QUERY_LAT   0.0
#define QUERY_LON   0.0

// Search radius in nautical miles (5 statute miles ≈ 4.34 NM)
#define QUERY_RADIUS_NM 5.0

// How often to poll the API in milliseconds
#define POLL_INTERVAL_MS 30000

// ntfy push notifications — leave NTFY_TOPIC empty to disable
// Create a topic at https://ntfy.sh and generate an access token
#define NTFY_TOKEN   ""
#define NTFY_TOPIC   ""
// Comma-separated classes to notify: MIL, MEDVAC, COMM, PRIV — empty = all
#define NTFY_CLASSES ""
